{
	"name": "GoLang DevContainer",
	"image": "mcr.microsoft.com/devcontainers/go:1",
	"features": {
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": ["golang.go", "ms-kubernetes-tools.vscode-kubernetes-tools", "bufbuild.vscode-buf"]
		}
	},
	"forwardPorts": [8081, 9092, 8080, 3000, 9090, 16686],
	"postCreateCommand": "go mod download",
	"remoteUser": "vscode"
}
